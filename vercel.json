{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/beneficiaries",
      "destination": "/api/beneficiaries"
    },
    {
      "source": "/api/process-transcript",
      "destination": "/api/process-transcript"
    },
    {
      "source": "/((?!api/|health).*)",
      "destination": "/index.html"
    }
  ]
}
